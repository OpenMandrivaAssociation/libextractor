diff -up -r libextractor-1.20.orig/src/main/extractor_plugins.h libextractor-1.20/src/main/extractor_plugins.h
--- libextractor-1.20.orig/src/main/extractor_plugins.h	2025-03-02 00:25:50.000000000 +0100
+++ libextractor-1.20/src/main/extractor_plugins.h	2026-11-11 21:05:23.524434275 +0100
@@ -28,7 +28,15 @@
 #include "platform.h"
 #include "extractor.h"
 #include <signal.h>
-#include <ltdl.h>
+#include <sltdl/sltdl.h>
+
+/* sltdl's lt_dlopenadvise ignores its advise argument. The advise
+   helpers are not provided, so keep the call sites and turn them
+   into no-ops. */
+#define lt_dladvise_init(p)    ((*(p) = (lt_dladvise) 0), 0)
+#define lt_dladvise_ext(p)     ((void) (p), 0)
+#define lt_dladvise_local(p)   ((void) (p), 0)
+#define lt_dladvise_destroy(p) ((*(p) = (lt_dladvise) 0), 0)
 
 
