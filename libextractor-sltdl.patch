diff -up -r libextractor-1.20.orig/configure.ac libextractor-1.20/configure.ac
--- libextractor-1.20.orig/configure.ac	2026-11-10 19:53:04.000000000 +0100
+++ libextractor-1.20/configure.ac	2026-11-11 21:04:58.185308342 +0100
@@ -274,27 +274,27 @@ AC_ARG_WITH(ltdl,
     AS_CASE([$with_ltdl],
       [no],[],
       [yes],[
-        AC_CHECK_HEADERS(ltdl.h,
-          AC_CHECK_LIB([ltdl], [lt_dlopenext],
